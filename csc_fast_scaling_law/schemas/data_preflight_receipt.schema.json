{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nanochat/data_preflight_receipt.schema.json",
  "title": "Nanochat data preflight receipt",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "code_commit",
    "verified_unix_time",
    "train",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "nanochat-data-preflight-v1"},
    "status": {"const": "verified"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "verified_unix_time": {"type": "integer", "minimum": 0},
    "train": {"$ref": "#/$defs/manifestProvenance"},
    "validation": {"$ref": "#/$defs/manifestProvenance"}
  },
  "additionalProperties": false,
  "$defs": {
    "manifestProvenance": {
      "type": "object",
      "required": [
        "schema_version",
        "dataset_id",
        "split",
        "manifest_path",
        "manifest_sha256",
        "shards"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "dataset_id": {"type": "string", "minLength": 1},
        "split": {"enum": ["train", "validation"]},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "shards": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/shard"}
        }
      },
      "additionalProperties": false
    },
    "shard": {
      "type": "object",
      "required": [
        "name",
        "path",
        "sha256",
        "observed_size_bytes",
        "observed_mtime_ns"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "observed_size_bytes": {"type": "integer", "minimum": 0},
        "observed_mtime_ns": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
