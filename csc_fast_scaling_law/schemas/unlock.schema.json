{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nanochat/unlock.schema.json",
  "title": "Nanochat sealed-target unlock",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "campaign_manifest_sha256",
    "plan_sha256",
    "decision_rules_sha256",
    "status",
    "task_ids"
  ],
  "properties": {
    "schema_version": {"const": "nanochat-unlock-v1"},
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "campaign_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "decision_rules_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"const": "unlocked"},
    "task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      }
    },
    "issued_at": {"type": "string"},
    "note": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
